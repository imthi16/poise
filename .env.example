# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Code reads these via poise/config.py.

# --- Model ---
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx        # gated model download (required)
POISE_MODEL_ID=deepseek-ai/DeepSeek-R1-Distill-Llama-8B
POISE_MODEL_PATH=                                       # OPTIONAL local snapshot dir;
                                                        # leave EMPTY to download via MODEL_ID.
                                                        # (a nonexistent path here => load error)
POISE_GGUF_PATH=/models/deepseek-r1-q4_k_m.gguf        # llama.cpp baseline ONLY
POISE_DEVICE=auto                                       # auto | cuda | mps | cpu
POISE_DTYPE=fp16                                        # fp16 | bnb-4bit   (NOT q4_k_m here)

# --- Depth / budget ---
POISE_LAYER_TOTAL=32
POISE_LAYER_MIN=16            # usable floor is set empirically by quality_profile; this is a guard
POISE_LAYER_MAX=32
POISE_BUDGET_SET=16,20,24,28,32   # discrete allowed depths (action space)

# --- Thermal targets ---
POISE_TEMP_SETPOINT_C=80.0   # PID setpoint
POISE_TEMP_MAX_C=87.0        # hard ceiling; crossing == failure event
POISE_AMBIENT_C=25.0

# --- PID gains (starting point — tune) ---
POISE_PID_KP=0.8
POISE_PID_KI=0.05
POISE_PID_KD=0.2
POISE_CONTROL_PERIOD_MS=250  # how often the controller re-evaluates

# --- Telemetry ---
POISE_TELEMETRY_BACKEND=auto # auto | jtop | nvml | tegrastats | mock
POISE_TELEMETRY_HZ=4

# --- RL policy ---
POISE_POLICY_PATH=/models/ppo_policy.zip   # empty => PID-only mode
POISE_CONTROL_MODE=pid                      # static | pid | ppo
POISE_STATIC_DEPTH=32                        # used only when mode=static

# --- Serving ---
POISE_API_HOST=0.0.0.0
POISE_API_PORT=8000
POISE_PROMETHEUS_PORT=9090

# --- Storage ---
POISE_DB_PATH=./data/results/poise.db

# --- RAG demo (public/synthetic ONLY) ---
POISE_RAG_DATA_DIR=./data/synthetic
POISE_RAG_INDEX_PATH=./data/synthetic/faiss.index

# --- Off-device training (Kaggle) ---
KAGGLE_USERNAME=your_kaggle_user
KAGGLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
